node_modules/
dist/
*.log

# local dev SQLite database (production uses /data, the Fly volume)
.data/

# Playwright e2e output (pnpm test:e2e)
test-results/
playwright-report/
blob-report/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# Wen's original reference photos are development references only: the repo is
# public, so they never get committed. Published scene images are processed
# derivatives (people removed, metadata stripped) under public/scenes/.
design/sound-of-a-city/references/**/*.jpeg
design/sound-of-a-city/references/**/*.jpg
design/sound-of-a-city/references/**/*.HEIC

# originals the sounds are cut from (scripts/fetch-sounds.mjs)
.cache/

# Curated validation transcripts are submission evidence, not runtime logs.
!docs/evidence/answers/*.log
