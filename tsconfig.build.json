{
  // Compiles only the app (src/) to dist/ for the Docker runtime image.
  // pnpm typecheck (tsconfig.json) still covers src/ with noEmit for CI/local
  // type checking; this config exists solely to produce runnable JS.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    // src/ imports use explicit .js specifiers (matching the compiled output,
    // as Node's ESM resolver requires) rather than the base config's bundler-
    // style .ts specifiers, so this isn't needed for the build and conflicts
    // with emitting.
    "allowImportingTsExtensions": false
  },
  "include": ["src"]
}
